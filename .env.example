# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- Exchange API credentials ---
# For paper trading: Binance testnet keys (testnet.binance.vision) and
# OKX Demo Trading keys (enable "Demo Trading" in your OKX account).
# For live trading: your real production keys. Never both at once.
BINANCE_API_KEY=
BINANCE_API_SECRET=

OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# --- Trading mode ---
# true = paper/testnet trading (safe). false = LIVE trading with real funds.
PAPER_TRADING_MODE=true

# --- Telegram notifications (optional; leave blank to disable) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Risk management (defaults shown — uncomment to override) ---
# MAX_TRADE_SIZE_USD=15.0
# MAX_DAILY_LOSS_USD=50.0
# MAX_CONSECUTIVE_LEG_RISK_EVENTS=2
# MIN_BASE_CURRENCY_BALANCE=0.0005
# LOW_BALANCE_WARNING_COOLDOWN_S=21600
